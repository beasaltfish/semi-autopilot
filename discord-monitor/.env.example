# Database Configuration
DB_USER=app_user
DB_HOST=localhost
DB_NAME=semi_autopilot
DB_PASSWORD=defaultpassword123
DB_PORT=5432

# Discord Channels (comma-separated list in format: guild_id/channel_id)
# Example: https://discord.com/channels/1209923224620761088/1306929468400599090 becomes 1209923224620761088/1306929468400599090
DISCORD_CHANNELS=1209923224620761088/1306929468400599090,123456789012345678/987654321098765432

# Optional: Path to save Discord session (to avoid re-login)
STORAGE_STATE_PATH=./discord-session.json

# Filtering Configuration
ENABLE_FILTERING=true
MIN_MESSAGE_LENGTH=30

# Optional: Custom trivial phrases (comma-separated)
CUSTOM_TRIVIAL_PHRASES=brb,afk,gtg

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

DISCORD_WEBHOOK_URL=
