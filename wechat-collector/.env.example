# Copy to .env (git-ignored) and fill in.

# WeChat's database directory. List candidates with:
#   ls -d ~/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/*/db_storage
WECHAT_DB_DIR=

# keys.json from wechat-key-macos's scripts/extract_key.py. Keep it OUTSIDE
# this repository: it reads every chat you have.
WECHAT_KEYS_PATH=
