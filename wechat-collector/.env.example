# Copy to .env (git-ignored) and fill in.

# Database (matches docker-compose.yml).
DB_USER=app_user
DB_HOST=localhost
DB_NAME=semi_autopilot
DB_PASSWORD=defaultpassword123
DB_PORT=5432

# WeChat's database directory. List candidates with:
#   ls -d ~/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/*/db_storage
WECHAT_DB_DIR=

# keys.json from wechat-key-macos's scripts/extract_key.py. Keep it OUTSIDE
# this repository: it reads every chat you have.
WECHAT_KEYS_PATH=

# Groups to collect, comma-separated @chatroom ids. List them with:
#   pnpm --filter wechat-collector groups
WECHAT_GROUPS=

# How often to look for new messages.
WECHAT_POLL_SECONDS=10
# How far behind the newest stored message each pass re-reads, to catch
# late-synced messages. Duplicates are dropped by the unique key.
WECHAT_OVERLAP_SECONDS=300
# How much history a newly enabled group takes on its first pass.
WECHAT_BACKFILL_DAYS=30

# Embeddings are not wired yet; leave EMBEDDING_MODEL empty to collect only.
EMBEDDING_MODEL=
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
WECHAT_EMBED_MIN_CHARS=4

# Notifications: Telegram when both are set, otherwise Discord when set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

LOG_LEVEL=info
