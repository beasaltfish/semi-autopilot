# Copy to .env (git-ignored) and fill in.

# Database (matches docker-compose.yml).
DB_USER=app_user
DB_HOST=localhost
DB_NAME=semi_autopilot
DB_PASSWORD=defaultpassword123
DB_PORT=5432

# Jev via OpenRouter's decisions endpoint, billed to your OpenRouter account.
OPENROUTER_API_KEY=
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_MS=30000

# The LLM that phrases drafts. One model, required.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000

# Who the owner is. WECHAT_OWNER_ID is your own wxid (never drafted to).
# WECHAT_OWNER_NAMES is what the groups call you, comma-separated.
WECHAT_OWNER_ID=
WECHAT_OWNER_NAMES=

# Telegram bot (BotFather token) and your own chat id — the only chat honoured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# System notifications (Jev/LLM down). Telegram when both set, else Discord.
DISCORD_WEBHOOK_URL=

# Routing thresholds (0..1).
INTENT_MIN=0.6
PRAISE_MIN=0.7
ADDRESSED_MIN=0.6

# Shadow-mode limits.
DRAFTS_PER_GROUP_PER_HOUR=4
TEMPLATE_COOLDOWN_MINUTES=180
CARD_EXPIRY_MINUTES=30
RESPONDER_POLL_SECONDS=15

LOG_LEVEL=info
